{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start user-app (Vite)",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend/user-app",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Tarot backend (Laravel)",
			"type": "shell",
			"command": "php",
			"args": [
				"backend/artisan",
				"serve",
				"--host=127.0.0.1",
				"--port=8000"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}